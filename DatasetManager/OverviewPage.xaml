<Page x:Class="DatasetManager.OverviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DatasetManager"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OverviewPage">

    <Grid Margin="10">
        <DataGrid x:Name="StatsGrid"
                  ItemsSource="{Binding Stats}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True" 
                  SelectionMode="Single"
                  SelectionUnit="Cell"
                  SelectedCellsChanged="StatsGrid_SelectedCellsChanged"> 
            <DataGrid.Columns>
                <DataGridTextColumn Header="Category" Binding="{Binding Category}" />
                <DataGridTextColumn Header="# Training Samples" Binding="{Binding TrainingSampleCount}" />
                <DataGridTextColumn Header="# Training WAVs" Binding="{Binding TrainingWavCount}" />
                <DataGridTextColumn Header="# Testing Samples" Binding="{Binding TestingSampleCount}" />
                <DataGridTextColumn Header="# Testing WAVs" Binding="{Binding TestingWavCount}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
