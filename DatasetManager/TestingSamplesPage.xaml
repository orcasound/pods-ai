<local:SamplesPageBase x:Class="DatasetManager.TestingSamplesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DatasetManager"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="TestingSamplesPage">
    <Page.Resources>
        <local:AndBooleanConverter x:Key="AndBooleanConverter" />
    </Page.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.ColumnSpan="5" Text="{Binding Category, StringFormat='{}Testing samples for {0}'}" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding FalsePositiveCount, StringFormat='{}False positives: {0}'}" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <Button Grid.Row="1" Grid.Column="1"
                Content="Analyze"
                Click="FindMispredictions_Click"
                Width="Auto"
                Margin="0,0,0,10">
            <Button.IsEnabled>
                <MultiBinding Converter="{StaticResource AndBooleanConverter}">
                    <Binding ElementName="SamplesGridControl" Path="InferenceEnabled" />
                    <Binding Path="HasFalsePositives" />
                </MultiBinding>
            </Button.IsEnabled>
        </Button>
        <local:SamplesGridControl Grid.Row="2" Grid.ColumnSpan="5" x:Name="SamplesGridControl" InferenceRequested="SamplesGrid_InferenceRequested" />
        <TextBlock Grid.Row="3" Grid.ColumnSpan="5" Text="Output:" FontSize="16" FontWeight="Bold" Margin="0,10,0,5"/>
        <local:LogViewerControl Grid.Row="4" Grid.ColumnSpan="5" x:Name="LogViewerControl"/>
        <Button Grid.Row="5" Grid.Column="0" Content="Back" Click="Back_Click" Width="100" Margin="0,0,0,10"/>
        <Button Grid.Row="5" Grid.Column="1"
                Content="Find more false positives"
                IsEnabled="{Binding ElementName=SamplesGridControl, Path=InferenceEnabled}"
                Click="MoreFalsePositives_Click"
                Width="Auto"
                Margin="0,0,0,10"/>
        <Button Grid.Row="5" Grid.Column="2"
                Content="Find more false negatives"
                IsEnabled="{Binding ElementName=SamplesGridControl, Path=InferenceEnabled}"
                Click="MoreFalseNegatives_Click"
                Width="Auto"
                Margin="0,0,0,10"/>
    </Grid>
</local:SamplesPageBase>
