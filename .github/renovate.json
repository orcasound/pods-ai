{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "dependencyDashboard": true,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^src\\/model_revisions\\.py$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+) versioning=(?<versioning>[^\\s]+).*?LATEST_PODSAI_MODEL_REVISION = \"(?<currentValue>[a-f0-9]{40})\""
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Track pinned PODS-AI model updates in the dependency dashboard issue.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "https://huggingface.co/davethaler/whale-call-detector"
      ],
      "dependencyDashboardApproval": true
    }
  ]
}
